---
import Section from "../Section.astro"

import { builds } from "@cv"
---

<Section title="Experiments" id="experiments">
  <ul>
    {
      builds.map(
        ({ name, event, description }) => {
          return (
            <li>
              <article>
                <header>
                  <div>
                    <h3>{name}</h3>
                    <h4>{event}</h4>
                  </div>
                </header>

                <footer>
                  <p>{description}</p>
                </footer>
              </article>
            </li>
          )
        }
      )
    }
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  article h3 {
    font-weight: 500;
    color: #111;
  }

  article h4 {
    color: #222;
    font-weight: 400;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 4px;
  }

  footer p {
    color: #666;
    font-size: 0.9rem;
    line-height: 1.5;
    text-wrap: pretty;
  }
</style>
